# Copy to .env for local development.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
DATABASE_URL=postgresql://medora:medora@localhost:5433/medora?schema=public
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
SESSION_TTL_HOURS=12
# Leave empty when the SPA is served from the same origin (or via the Vite proxy).
CORS_ORIGIN=
# Demo deployments: show demo accounts on the login page and allow "Reset demo data".
DEMO_MODE=true
# Pin the clinical clock so seeded "today" queues stay meaningful. Remove for wall time.
CLOCK_START_AT=2026-10-16T09:00:00.000Z
# Symptom checks: an LLM assesses OLDCARTS histories on top of deterministic safety rules.
# Without credentials (or with TRIAGE_AI=false) checks use the safety rules alone.
# Patient context sent to the model: age, sex, conditions, allergies, latest vitals - never
# names, MRNs or phone numbers. Confirm your data-processing terms before enabling in production.
TRIAGE_AI=true
TRIAGE_PROVIDER=gemini
# Gemini (default): key from https://aistudio.google.com/apikey
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Optional: MINIMAL | LOW | MEDIUM | HIGH (only on models that support thinking levels)
# GEMINI_THINKING_LEVEL=HIGH
# Claude (TRIAGE_PROVIDER=claude): ANTHROPIC_API_KEY, ANTHROPIC_AUTH_TOKEN or an `ant auth login` profile
# ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=high
LOG_LEVEL=info
